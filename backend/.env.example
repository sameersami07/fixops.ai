# FixOps Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB - Replace with your MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/fixops
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fixops
MONGODB_URI=mongodb://localhost:27017/fixops

# Set a unique, randomly generated secret for deployments.
# If left empty, the backend generates a temporary secret on startup.
JWT_SECRET=

# Google Gemini AI API Key
# Get your API key from: https://aistudio.google.com/
# Steps: 
#   1. Go to https://aistudio.google.com/
#   2. Sign in with your Google account
#   3. Click "Get API key" in the left sidebar
#   4. Click "Create API key"
#   5. Copy the key and paste it below
GEMINI_API_KEY=AQ.Ab8RN6IN8vb5hU5_Q7MBIlG2uFAMhfgepdMHe_SuTA8AO2y9oA

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
